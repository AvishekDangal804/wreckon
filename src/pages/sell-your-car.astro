---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Container from "../components/Container.astro";
import VehicleValuationForm from "../components/VehicleValuationForm.astro";
import sellYourCarPhoto from "../assets/sell-your-car.jpg";
---
<BaseLayout
  title="Sell Your Car"
  description="Get a quote for your old, damaged or unwanted vehicle."
>
  <Hero
    eyebrow="Cash for Cars"
    title="Sell your car, quickly and simply."
    subtitle="Old, damaged, unregistered or just unwanted — tell us about your vehicle and we'll get back to you with a quote."
    primaryCta={{ label: "Get a Quote Below", href: "#quote" }}
    image={sellYourCarPhoto}
    imageAlt="Selling a car to WRECKON"
  />

  <Container class="py-16">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div class="rounded-sm border border-ink-600/15 bg-white p-5">
        <p class="font-display text-sm font-bold uppercase tracking-wide text-amber-600">No Obligation</p>
        <p class="mt-1 text-sm text-ink-600">Get a quote with no pressure to accept.</p>
      </div>
      <div class="rounded-sm border border-ink-600/15 bg-white p-5">
        <p class="font-display text-sm font-bold uppercase tracking-wide text-amber-600">Any Condition</p>
        <p class="mt-1 text-sm text-ink-600">Running or not, damaged or unregistered — tell us anyway.</p>
      </div>
      <div class="rounded-sm border border-ink-600/15 bg-white p-5">
        <p class="font-display text-sm font-bold uppercase tracking-wide text-amber-600">Secure Payment</p>
        <p class="mt-1 text-sm text-ink-600">Paid by bank transfer or EFT, in line with AU regulations.</p>
      </div>
    </div>
  </Container>

  <Container class="pb-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-3">
      <div class="content md:col-span-1">
        <h2 class="font-display text-2xl font-bold text-ink-900">How it works</h2>
        <ol class="mt-4 space-y-3 text-sm text-ink-700">
          <li><strong>1. Tell us about your vehicle</strong> — make, model, year and condition.</li>
          <li><strong>2. We get back to you</strong> with a quote.</li>
          <li><strong>3. If you accept</strong>, we arrange pick-up and payment by bank transfer or EFT.</li>
        </ol>

        <h2 class="mt-10 font-display text-2xl font-bold text-ink-900">What we buy</h2>
        <ul class="mt-4 space-y-2 text-sm text-ink-700">
          <li>Old or high-mileage vehicles</li>
          <li>Damaged or accident-affected vehicles</li>
          <li>Unregistered vehicles</li>
          <li>Vehicles that are no longer running</li>
        </ul>

        <p class="mt-6 rounded-sm bg-ink-100 p-4 text-xs text-ink-600">
          Vehicle payments are made by bank transfer or EFT, in line with current Australian regulations
          restricting cash payments for vehicle purchases.
        </p>
      </div>

      <div id="quote" class="md:col-span-2 rounded-sm border border-ink-600/15 bg-white p-6">
        <h2 class="font-display text-lg font-semibold text-ink-900">Get a Quote</h2>
        <div class="mt-6">
          <VehicleValuationForm submitLabel="Get a Quote" />
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>
