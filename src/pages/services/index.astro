---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Card from "../../components/Card.astro";
import vehicleRemovalPhoto from "../../assets/vehicle-removal.jpg";
import sellYourCarPhoto from "../../assets/sell-your-car.jpg";
import usedPartsPhoto from "../../assets/used-parts.jpg";
import wreckingPhoto from "../../assets/wrecking.jpg";

const serviceImages: Record<string, ImageMetadata> = {
  "vehicle-removal": vehicleRemovalPhoto,
  "sell-your-car": sellYourCarPhoto,
  "used-parts": usedPartsPhoto,
  "wrecking": wreckingPhoto,
};

const services = await getCollection("services");
---
<BaseLayout
  title="Services"
  description="Vehicle buying, wrecking, used parts sales and removal services from WRECKON."
>
  <Container class="py-16">
    <h1 class="font-display text-4xl font-bold text-ink-900">Our Services</h1>
    <p class="mt-3 max-w-xl text-ink-600">
      Here's how we can help, whether you're selling a vehicle or looking for parts.
      Descriptions below are preliminary, pending final confirmation from the business.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {services.map((service) => (
        <Card
          title={service.data.name}
          blurb={service.data.summary}
          href={`/services/${service.id}`}
          image={serviceImages[service.id]}
          imageAlt={serviceImages[service.id] ? `WRECKON ${service.data.name}` : undefined}
        />
      ))}
    </div>
  </Container>
</BaseLayout>
