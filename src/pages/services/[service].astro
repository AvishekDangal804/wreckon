---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EnquiryForm from "../../components/EnquiryForm.astro";
import PartsEnquiryForm from "../../components/PartsEnquiryForm.astro";
import VehicleValuationForm from "../../components/VehicleValuationForm.astro";
import vehicleRemovalPhoto from "../../assets/vehicle-removal.jpg";
import sellYourCarPhoto from "../../assets/sell-your-car.jpg";
import usedPartsPhoto from "../../assets/used-parts.jpg";
import wreckingPhoto from "../../assets/wrecking.jpg";

const serviceImages: Record<string, ImageMetadata> = {
  "vehicle-removal": vehicleRemovalPhoto,
  "sell-your-car": sellYourCarPhoto,
  "used-parts": usedPartsPhoto,
  "wrecking": wreckingPhoto,
};

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { service: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const bannerImage = serviceImages[service.id];
---
<BaseLayout title={service.data.name} description={service.data.summary}>
  <div class="relative overflow-hidden bg-ink-950 py-20 text-ink-50">
    {bannerImage && (
      <>
        <Image
          src={bannerImage}
          alt={`WRECKON ${service.data.name}`}
          class="absolute inset-0 h-full w-full object-cover"
          widths={[640, 1024, 1600]}
          sizes="100vw"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink-950/90 via-ink-950/55 to-transparent"></div>
      </>
    )}
    <Container class="relative">
      <Breadcrumbs dark items={[{ label: "Home", href: "/" }, { label: "Services", href: "/services" }, { label: service.data.name }]} />
      <p class="mt-4 text-sm font-semibold uppercase tracking-widest text-amber-400">Service</p>
      <h1 class="mt-3 font-display text-4xl font-bold">{service.data.name}</h1>
      <p class="mt-3 max-w-xl text-ink-200">{service.data.summary}</p>
    </Container>
  </div>

  <Container class="grid grid-cols-1 gap-12 py-16 md:grid-cols-3">
    <div class="content md:col-span-2">
      <Content />
    </div>

    <div class="rounded-sm border border-ink-600/15 bg-white p-6">
      <h2 class="font-display text-lg font-semibold text-ink-900">{service.data.ctaLabel}</h2>
      <p class="mt-2 text-sm text-ink-600">Send us your details and we'll be in touch.</p>
      <div class="mt-6">
        {service.id === "sell-your-car" ? (
          <VehicleValuationForm submitLabel={service.data.ctaLabel} />
        ) : service.id === "used-parts" ? (
          <PartsEnquiryForm submitLabel={service.data.ctaLabel} />
        ) : (
          <EnquiryForm subject={service.data.name} submitLabel={service.data.ctaLabel} />
        )}
      </div>
    </div>
  </Container>
</BaseLayout>
