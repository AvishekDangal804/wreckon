---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import PartsEnquiryForm from "../../components/PartsEnquiryForm.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import bodyPanelsPhoto from "../../assets/parts/body-panels.jpg";
import coolingPhoto from "../../assets/parts/cooling.jpg";
import electricalPhoto from "../../assets/parts/electrical.jpg";
import enginesPhoto from "../../assets/parts/engines.jpg";
import lightsPhoto from "../../assets/parts/lights.jpg";
import suspensionSteeringPhoto from "../../assets/parts/suspension-steering.jpg";
import transmissionsPhoto from "../../assets/parts/transmissions.jpg";
import wheelsPhoto from "../../assets/parts/wheels.jpg";

const categoryImages: Record<string, ImageMetadata> = {
  "body-panels": bodyPanelsPhoto,
  "cooling": coolingPhoto,
  "electrical": electricalPhoto,
  "engines": enginesPhoto,
  "lights": lightsPhoto,
  "suspension-steering": suspensionSteeringPhoto,
  "transmissions": transmissionsPhoto,
  "wheels": wheelsPhoto,
};

export async function getStaticPaths() {
  const categories = await getCollection("partsCategories");
  return categories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const { Content } = await render(category);
const bannerImage = categoryImages[category.id];
---
<BaseLayout title={category.data.name} description={category.data.blurb}>
  <div class="relative overflow-hidden bg-ink-950 py-20 text-ink-50">
    {bannerImage && (
      <>
        <Image
          src={bannerImage}
          alt={`WRECKON used ${category.data.name}`}
          class="absolute inset-0 hidden h-full w-full object-cover md:block"
          widths={[640, 1024, 1600]}
          sizes="100vw"
        />
        <div class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-ink-950/90 via-ink-950/55 to-transparent md:block"></div>
      </>
    )}
    <Container class="relative">
      <Breadcrumbs dark items={[{ label: "Home", href: "/" }, { label: "Parts", href: "/parts" }, { label: category.data.name }]} />
      <p class="mt-4 text-sm font-semibold uppercase tracking-widest text-amber-400">Used Parts</p>
      <h1 class="mt-3 font-display text-4xl font-bold">{category.data.name}</h1>
      <p class="mt-3 max-w-xl text-ink-200">{category.data.blurb}</p>
    </Container>
  </div>

  <Container class="grid grid-cols-1 gap-12 py-16 md:grid-cols-3">
    <div class="content md:col-span-2">
      <Content />
      <p class="mt-6 rounded-sm bg-ink-100 p-4 text-sm text-ink-600">
        Live stock listings aren't available on the site yet — send us your vehicle and part details below and we'll check what we have.
      </p>
    </div>

    <div class="rounded-sm border border-ink-600/15 bg-white p-6">
      <h2 class="font-display text-lg font-semibold text-ink-900">Request This Part</h2>
      <p class="mt-2 text-sm text-ink-600">Tell us your vehicle details and we'll get back to you.</p>
      <div class="mt-6">
        <PartsEnquiryForm defaultPartName={category.data.name} submitLabel="Request This Part" />
      </div>
    </div>
  </Container>
</BaseLayout>
