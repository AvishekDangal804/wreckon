---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import PartsEnquiryForm from "../../components/PartsEnquiryForm.astro";
---
<BaseLayout
  title="Request a Part"
  description="Tell us the part and vehicle details you're after and we'll check availability."
>
  <Container class="py-16">
    <div class="mx-auto max-w-2xl">
      <h1 class="font-display text-4xl font-bold text-ink-900">Request a Part</h1>
      <p class="mt-3 text-ink-600">
        Know what you need? Tell us the vehicle and part details below and we'll check what's available.
      </p>

      <div class="mt-10 rounded-2xl border border-ink-600/15 bg-white p-6">
        <PartsEnquiryForm submitLabel="Request This Part" />
      </div>
    </div>
  </Container>
</BaseLayout>
