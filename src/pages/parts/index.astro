---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Card from "../../components/Card.astro";
import bodyPanelsPhoto from "../../assets/parts/body-panels.jpg";
import coolingPhoto from "../../assets/parts/cooling.jpg";
import electricalPhoto from "../../assets/parts/electrical.jpg";
import enginesPhoto from "../../assets/parts/engines.jpg";
import lightsPhoto from "../../assets/parts/lights.jpg";
import suspensionSteeringPhoto from "../../assets/parts/suspension-steering.jpg";
import transmissionsPhoto from "../../assets/parts/transmissions.jpg";
import wheelsPhoto from "../../assets/parts/wheels.jpg";

const categoryImages: Record<string, ImageMetadata> = {
  "body-panels": bodyPanelsPhoto,
  "cooling": coolingPhoto,
  "electrical": electricalPhoto,
  "engines": enginesPhoto,
  "lights": lightsPhoto,
  "suspension-steering": suspensionSteeringPhoto,
  "transmissions": transmissionsPhoto,
  "wheels": wheelsPhoto,
};

const partsCategories = await getCollection("partsCategories");
---
<BaseLayout
  title="Used Parts"
  description="Browse used auto parts by category, or request a part and we'll check availability."
>
  <Container class="py-16">
    <h1 class="font-display text-4xl font-bold text-ink-900">Used Parts</h1>
    <p class="mt-3 max-w-xl text-ink-600">
      Browse by category below, or <a href="/parts/request" class="font-semibold text-amber-600 hover:text-amber-500">request a part</a> directly if you know what you're after.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {partsCategories.map((category) => (
        <Card
          title={category.data.name}
          blurb={category.data.blurb}
          href={`/parts/${category.id}`}
          image={categoryImages[category.id]}
          imageAlt={categoryImages[category.id] ? `WRECKON used ${category.data.name}` : undefined}
        />
      ))}
    </div>
  </Container>
</BaseLayout>
