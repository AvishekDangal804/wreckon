---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Card from "../../components/Card.astro";
import Placeholder from "../../components/Placeholder.astro";

const partsCategories = await getCollection("partsCategories");
---
<BaseLayout
  title="Used Parts"
  description="Browse used auto parts by category, or request a part and we'll check availability."
>
  <Container class="py-16">
    <h1 class="flex flex-wrap items-center gap-3 font-display text-4xl font-bold text-ink-900">
      Used Parts
      <Placeholder label="SAMPLE CONTENT" />
    </h1>
    <p class="mt-3 max-w-xl text-ink-600">
      Browse by category below, or <a href="/parts/request" class="font-semibold text-amber-600 hover:text-amber-500">request a part</a> directly if you know what you're after.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {partsCategories.map((category) => (
        <Card
          title={category.data.name}
          blurb={category.data.blurb}
          href={`/parts/${category.id}`}
          badge="SAMPLE CONTENT"
        />
      ))}
    </div>
  </Container>
</BaseLayout>
