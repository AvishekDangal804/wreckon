---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import { siteConfig } from "../lib/siteConfig";
import aboutPhoto from "../assets/about.jpg";
---
<BaseLayout
  title="About & Contact"
  description="About WRECKON and how to get in touch for parts enquiries, quotes or general questions."
>
  <Container class="py-16">
    <h1 class="font-display text-4xl font-bold text-ink-900">About WRECKON</h1>
    <p class="mt-3 max-w-2xl text-lg text-ink-600">
      We're an Australian auto wrecking and used parts business — buying vehicles, dismantling them
      responsibly, and supplying quality-checked used parts back into the market.
    </p>

    <div class="mt-8 overflow-hidden rounded-sm">
      <Image
        src={aboutPhoto}
        alt="Inside the WRECKON parts warehouse"
        class="h-64 w-full object-cover md:h-80"
        widths={[640, 1024, 1600]}
        sizes="100vw"
      />
    </div>

    <div class="content mt-10 max-w-2xl">
      <h2>What We Do</h2>
      <p>
        We buy old, damaged and unwanted vehicles, then dismantle them to recover parts that still
        have life left in them. Those parts are checked and made available for sale, while the rest
        of the vehicle is handled responsibly rather than left to waste.
      </p>
      <p>
        If you're after a part, you can browse by category or vehicle make, or send us your details
        directly and we'll check what's available. If you've got a vehicle to sell, we'll give you a
        straightforward quote and arrange pick-up.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div class="group rounded-sm border border-ink-600/15 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-amber-400 hover:shadow-lg">
        <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-amber-50 text-amber-600 transition-colors duration-300 group-hover:bg-amber-400 group-hover:text-ink-950">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
            <circle cx="12" cy="12" r="9" />
            <path d="M8 12l3 3 5-6" />
          </svg>
        </div>
        <p class="mt-4 font-display text-sm font-bold uppercase tracking-wide text-ink-900">Quality Checked</p>
        <p class="mt-1 text-sm text-ink-600">Parts are checked before they go back out, not sold sight unseen.</p>
      </div>

      <div class="group rounded-sm border border-ink-600/15 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-amber-400 hover:shadow-lg">
        <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-amber-50 text-amber-600 transition-colors duration-300 group-hover:bg-amber-400 group-hover:text-ink-950">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
            <path d="M4 12h12m0 0-4-4m4 4-4 4" />
            <path d="M20 6v12" />
          </svg>
        </div>
        <p class="mt-4 font-display text-sm font-bold uppercase tracking-wide text-ink-900">Straightforward Process</p>
        <p class="mt-1 text-sm text-ink-600">Tell us what you need, and we'll get back to you directly — no runaround.</p>
      </div>

      <div class="group rounded-sm border border-ink-600/15 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-amber-400 hover:shadow-lg">
        <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-amber-50 text-amber-600 transition-colors duration-300 group-hover:bg-amber-400 group-hover:text-ink-950">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
            <path d="M12 3c4 2 7 5 7 9a7 7 0 0 1-14 0c0-4 3-7 7-9Z" />
          </svg>
        </div>
        <p class="mt-4 font-display text-sm font-bold uppercase tracking-wide text-ink-900">Responsible & Compliant</p>
        <p class="mt-1 text-sm text-ink-600">Vehicles are handled responsibly, with payments made in line with AU regulations.</p>
      </div>
    </div>

    <div class="mt-16 border-t border-ink-200 pt-12">
      <h2 class="font-display text-3xl font-bold text-ink-900">Get in Touch</h2>
      <p class="mt-2 max-w-xl text-ink-600">We're happy to help with parts enquiries, quotes or general questions.</p>

      <div class="mt-10 grid grid-cols-1 gap-12 md:grid-cols-3">
        <dl class="space-y-4 text-sm">
          <div>
            <dt class="font-semibold text-ink-900">Phone</dt>
            <dd class="flex items-center gap-2 text-ink-600">
              <span>{siteConfig.phone.display}</span>
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-900">Email</dt>
            <dd class="flex items-center gap-2 text-ink-600">
              <span>{siteConfig.email}</span>
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-900">Address</dt>
            <dd class="flex items-center gap-2 text-ink-600">
              <span>{siteConfig.address.street}, {siteConfig.address.suburb} {siteConfig.address.state} {siteConfig.address.postcode}</span>
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-900">Hours</dt>
            <dd class="text-ink-600">
              {siteConfig.hours.map((h) => (
                <span class="block">{h.days}: {h.time}</span>
              ))}
            </dd>
          </div>
        </dl>

        <div class="md:col-span-2 rounded-sm border border-ink-600/15 bg-white p-6">
          <h3 class="font-display text-lg font-semibold text-ink-900">Send an Enquiry</h3>
          <div class="mt-6">
            <EnquiryForm subject="General Enquiry" showVehicleFields={true} submitLabel="Send Enquiry" />
          </div>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>
