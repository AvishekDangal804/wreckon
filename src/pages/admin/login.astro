---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";
import { isAdminConfigured } from "../../lib/adminSession";

export const prerender = false;

const configured = isAdminConfigured();
const hasError = Astro.url.searchParams.has("error");
---
<BaseLayout title="Admin Login" description="WRECKON admin login." noindex>
  <Container class="py-20">
    <div class="mx-auto max-w-sm">
      <h1 class="font-display text-2xl font-bold text-ink-900">Admin Login</h1>

      {configured ? (
        <form method="POST" action="/api/admin/login" class="mt-6 flex flex-col gap-4">
          <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
            Password
            <input required name="password" type="password" class="field-input" />
          </label>
          {hasError && <p class="text-sm text-red-700">Incorrect password.</p>}
          <Button type="submit">Log In</Button>
        </form>
      ) : (
        <p class="mt-6 rounded-sm bg-ink-100 p-4 text-sm text-ink-700">
          Admin access isn't configured yet — set <code>ADMIN_PASSWORD</code> and <code>SESSION_SECRET</code> in
          your environment variables to enable it. See the README.
        </p>
      )}
    </div>
  </Container>
</BaseLayout>
