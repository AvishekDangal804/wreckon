---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PlaceholderNotice from "../components/PlaceholderNotice.astro";
---
<BaseLayout title="Terms &amp; Conditions" description="Terms and conditions for using the WRECKON website.">
  <Container class="py-16">
    <div class="max-w-2xl">
      <PlaceholderNotice label="CLIENT CONTENT REQUIRED">
        <strong>Draft — not legally reviewed.</strong> This placeholder must be reviewed by the business
        (and ideally a legal advisor) before the site goes live.
      </PlaceholderNotice>

      <h1 class="mt-8 font-display text-4xl font-bold text-ink-900">Terms &amp; Conditions</h1>
      <div class="content mt-6">
        <p>These terms will cover use of the WRECKON website, including enquiry and quote forms, the
          accuracy of parts information, and any conditions that apply to quotes, vehicle sales or
          part sales.</p>
        <p>Final wording should be confirmed with the business before publishing.</p>
      </div>
    </div>
  </Container>
</BaseLayout>
