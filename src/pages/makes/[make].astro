---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import PartsEnquiryForm from "../../components/PartsEnquiryForm.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

export async function getStaticPaths() {
  const makes = await getCollection("makes");
  return makes.map((make) => ({
    params: { make: make.id },
    props: { make },
  }));
}

const { make } = Astro.props;
const { Content } = await render(make);
---
<BaseLayout title={`${make.data.name} Parts`} description={make.data.blurb}>
  <div class="bg-ink-950 py-16 text-ink-50">
    <Container>
      <Breadcrumbs dark items={[{ label: "Home", href: "/" }, { label: "Makes", href: "/makes" }, { label: make.data.name }]} />
      <p class="mt-4 text-sm font-semibold uppercase tracking-widest text-amber-400">Make</p>
      <h1 class="mt-3 font-display text-4xl font-bold">{make.data.name} Parts</h1>
      <p class="mt-3 max-w-xl text-ink-200">{make.data.blurb}</p>
    </Container>
  </div>

  <Container class="grid grid-cols-1 gap-12 py-16 md:grid-cols-3">
    <div class="content md:col-span-2">
      <Content />
      <p class="mt-6 rounded-sm bg-ink-100 p-4 text-sm text-ink-600">
        We don't have live stock listings on the site yet — send us your model, year and the part you need and we'll check availability.
      </p>
    </div>

    <div class="rounded-sm border border-ink-600/15 bg-white p-6">
      <h2 class="font-display text-lg font-semibold text-ink-900">Request a {make.data.name} Part</h2>
      <div class="mt-6">
        <PartsEnquiryForm defaultVehicleMake={make.data.name} submitLabel="Request This Part" />
      </div>
    </div>
  </Container>
</BaseLayout>
