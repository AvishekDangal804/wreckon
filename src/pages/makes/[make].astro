---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import PartsEnquiryForm from "../../components/PartsEnquiryForm.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import makesBanner from "../../assets/makes-banner.jpg";

const logos = import.meta.glob<{ default: ImageMetadata }>("../../assets/makes/*.png", { eager: true });
const makeLogos: Record<string, ImageMetadata> = {};
for (const path in logos) {
  const id = path.split("/").pop()!.replace(".png", "");
  makeLogos[id] = logos[path].default;
}

const partsCategories = (await getCollection("partsCategories")).sort((a, b) => a.data.name.localeCompare(b.data.name));

export async function getStaticPaths() {
  const makes = await getCollection("makes");
  return makes.map((make) => ({
    params: { make: make.id },
    props: { make },
  }));
}

const { make } = Astro.props;
const { Content } = await render(make);
const logo = makeLogos[make.id];
---
<BaseLayout title={`${make.data.name} Parts`} description={make.data.blurb}>
  <div class="relative overflow-hidden bg-ink-950 py-16 text-ink-50">
    <Image
      src={makesBanner}
      alt="WRECKON used auto parts warehouse"
      class="absolute inset-0 hidden h-full w-full object-cover md:block"
      widths={[640, 934]}
      sizes="100vw"
    />
    <div class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-ink-950/90 via-ink-950/55 to-transparent md:block"></div>
    <Container class="relative">
      <Breadcrumbs dark items={[{ label: "Home", href: "/" }, { label: "Makes", href: "/makes" }, { label: make.data.name }]} />
      <div class="mt-4 flex items-center gap-4">
        {logo && (
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-sm bg-white p-2">
            <Image src={logo} alt={`${make.data.name} logo`} class="h-full w-full object-contain" widths={[80]} sizes="80px" />
          </div>
        )}
        <p class="text-sm font-semibold uppercase tracking-widest text-amber-400">Make</p>
      </div>
      <h1 class="mt-3 font-display text-4xl font-bold">{make.data.name} Parts</h1>
      <p class="mt-3 max-w-xl text-ink-200">{make.data.blurb}</p>
    </Container>
  </div>

  <Container class="grid grid-cols-1 gap-12 py-16 md:grid-cols-3">
    <div class="md:col-span-2">
      <div class="content">
        <Content />
      </div>

      <div class="mt-8 rounded-sm border border-ink-200 bg-ink-50 p-6">
        <h2 class="font-display text-lg font-bold text-ink-900">Common {make.data.name} Parts We Stock</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {partsCategories.map((category) => (
            <a
              href="/parts#request"
              class="rounded-full border border-ink-600/20 bg-white px-4 py-1.5 text-sm font-medium text-ink-700 transition-colors hover:border-amber-400 hover:bg-amber-50 hover:text-amber-600"
            >
              {category.data.name}
            </a>
          ))}
        </div>
      </div>

      <div class="mt-6 rounded-sm border border-ink-200 bg-ink-50 p-6">
        <h2 class="font-display text-lg font-bold text-ink-900">What to Tell Us</h2>
        <ul class="mt-4 space-y-2 text-sm text-ink-700">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
            Model, year and engine/variant, if you know it
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
            Which part you need, as specific as possible
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
            A photo of the damaged or failed part, if relevant
          </li>
        </ul>
      </div>

      <p class="mt-6 rounded-sm bg-ink-100 p-4 text-sm text-ink-600">
        We don't have live stock listings on the site yet — send us your model, year and the part you need and we'll check availability.
      </p>
    </div>

    <div class="rounded-sm border border-ink-600/15 bg-white p-6">
      <h2 class="font-display text-lg font-semibold text-ink-900">Request a {make.data.name} Part</h2>
      <div class="mt-6">
        <PartsEnquiryForm defaultVehicleMake={make.data.name} submitLabel="Request This Part" />
      </div>
    </div>
  </Container>
</BaseLayout>
