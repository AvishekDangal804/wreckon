---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Placeholder from "../../components/Placeholder.astro";

const makes = (await getCollection("makes")).sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<BaseLayout
  title="Browse by Make"
  description="Browse used parts by vehicle make."
>
  <Container class="py-16">
    <h1 class="flex flex-wrap items-center gap-3 font-display text-4xl font-bold text-ink-900">
      Browse by Make
      <Placeholder label="SAMPLE CONTENT" />
    </h1>
    <p class="mt-3 max-w-xl text-ink-600">Select a make below to see what we typically stock.</p>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
      {makes.map((make) => (
        <a
          href={`/makes/${make.id}`}
          class="flex flex-col items-center justify-center gap-2 rounded-sm border border-ink-600/15 bg-white px-4 py-6 text-center font-display font-semibold text-ink-800 hover:border-amber-400 hover:text-amber-500"
        >
          {make.data.name}
          <Placeholder label="SAMPLE CONTENT" />
        </a>
      ))}
    </div>
  </Container>
</BaseLayout>
