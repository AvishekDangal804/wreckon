---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
---
<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist." noindex>
  <Container class="flex flex-col items-center justify-center py-32 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-amber-500">404</p>
    <h1 class="mt-3 font-display text-3xl font-bold text-ink-900">We couldn't find that page</h1>
    <p class="mt-3 max-w-md text-ink-600">
      Try browsing our <a href="/parts" class="font-semibold text-amber-600 hover:text-amber-500">used parts</a>,
      <a href="/makes" class="font-semibold text-amber-600 hover:text-amber-500">vehicle makes</a>, or
      head back <a href="/" class="font-semibold text-amber-600 hover:text-amber-500">home</a>.
    </p>
  </Container>
</BaseLayout>
