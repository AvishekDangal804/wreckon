---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Container from "../components/Container.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import Placeholder from "../components/Placeholder.astro";
import type { ImageMetadata } from "astro";
import vehicleRemovalPhoto from "../assets/vehicle-removal.jpg";
import sellYourCarPhoto from "../assets/sell-your-car.jpg";

const serviceImages: Record<string, ImageMetadata> = {
  "vehicle-removal": vehicleRemovalPhoto,
  "sell-your-car": sellYourCarPhoto,
};

const services = await getCollection("services");
const partsCategories = (await getCollection("partsCategories")).slice(0, 6);
const popularMakes = (await getCollection("makes"))
  .filter((m) => m.data.popular)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const howItWorksSteps = [
  { title: "Tell us what you need", body: "A part, or a vehicle you want to sell — give us the details." },
  { title: "We check availability", body: "For parts requests, we check what we've got against your vehicle." },
  { title: "We get back to you", body: "With pricing and next steps, by phone or email." },
];
---
<BaseLayout
  title="Home"
  description="WRECKON is an Australian auto wrecker and used parts supplier — browse parts by category or vehicle make, or get a quote for your car."
>
  <Hero
    eyebrow="Australian Auto Wreckers"
    title="Quality used parts. A straightforward process."
    subtitle="Tell us about the part you need or the car you want to sell, and we'll get back to you with next steps."
    primaryCta={{ label: "Contact Us", href: "/contact" }}
    secondaryCta={{ label: "Browse Parts", href: "/parts" }}
  />

  <TrustStrip />

  <Container class="py-20">
    <h2 class="font-display text-3xl font-bold text-ink-900">Our Services</h2>
    <p class="mt-2 max-w-xl text-ink-600">
      From selling your car to sourcing used parts, here's how we can help.
      Descriptions below are preliminary, pending final confirmation from the business.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <Card
          title={service.data.name}
          blurb={service.data.summary}
          href={`/services/${service.id}`}
          image={serviceImages[service.id]}
          imageAlt={serviceImages[service.id] ? `WRECKON ${service.data.name}` : undefined}
        />
      ))}
    </div>
  </Container>

  <Container class="py-20">
    <h2 class="font-display text-3xl font-bold text-ink-900">How It Works</h2>
    <div class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-sm border border-ink-200 bg-ink-200 sm:grid-cols-3">
      {howItWorksSteps.map((step, index) => (
        <div class="bg-white p-6">
          <span class="font-display text-3xl font-bold text-ink-200">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="mt-3 font-display text-lg font-bold text-ink-900">{step.title}</h3>
          <p class="mt-2 text-sm text-ink-600">{step.body}</p>
        </div>
      ))}
    </div>
  </Container>

  <div class="bg-ink-100 py-20">
    <Container>
      <h2 class="flex flex-wrap items-center gap-3 font-display text-3xl font-bold text-ink-900">
        Used Parts by Category
        <Placeholder label="SAMPLE CONTENT" />
      </h2>
      <p class="mt-2 max-w-xl text-ink-600">A sample of the part categories we stock. Tell us what you need and we'll check availability.</p>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {partsCategories.map((category) => (
          <Card
            title={category.data.name}
            blurb={category.data.blurb}
            href={`/parts/${category.id}`}
            badge="SAMPLE CONTENT"
          />
        ))}
      </div>

      <a href="/parts" class="mt-8 inline-block text-sm font-semibold text-amber-600 hover:text-amber-500">
        View all categories &rarr;
      </a>
    </Container>
  </div>

  <Container class="py-20">
    <h2 class="flex flex-wrap items-center gap-3 font-display text-3xl font-bold text-ink-900">
      Browse by Make
      <Placeholder label="SAMPLE CONTENT" />
    </h2>
    <p class="mt-2 max-w-xl text-ink-600">A sample of the makes we commonly wreck for parts.</p>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
      {popularMakes.map((make) => (
        <a
          href={`/makes/${make.id}`}
          class="flex flex-col items-center justify-center gap-2 rounded-sm border border-ink-600/15 bg-white px-4 py-6 text-center font-display font-semibold text-ink-800 hover:border-amber-400 hover:text-amber-500"
        >
          {make.data.name}
          <Placeholder label="SAMPLE CONTENT" />
        </a>
      ))}
    </div>

    <a href="/makes" class="mt-8 inline-block text-sm font-semibold text-amber-600 hover:text-amber-500">
      View all makes &rarr;
    </a>
  </Container>

  <div class="bg-ink-950 py-20 text-center text-ink-50">
    <Container>
      <h2 class="font-display text-3xl font-bold">Can't find what you're after?</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-200">
        Send us your part or vehicle details directly and we'll check what's available.
      </p>
      <Button href="/contact" class="mt-8">Contact Us</Button>
    </Container>
  </div>
</BaseLayout>
