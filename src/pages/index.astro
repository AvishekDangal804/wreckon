---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Container from "../components/Container.astro";
import Card from "../components/Card.astro";
import Placeholder from "../components/Placeholder.astro";
import type { ImageMetadata } from "astro";
import vehicleRemovalPhoto from "../assets/vehicle-removal.jpg";
import sellYourCarPhoto from "../assets/sell-your-car.jpg";
import usedPartsPhoto from "../assets/used-parts.jpg";
import wreckingPhoto from "../assets/wrecking.jpg";
import bodyPanelsPhoto from "../assets/parts/body-panels.jpg";
import coolingPhoto from "../assets/parts/cooling.jpg";
import electricalPhoto from "../assets/parts/electrical.jpg";
import enginesPhoto from "../assets/parts/engines.jpg";
import lightsPhoto from "../assets/parts/lights.jpg";
import suspensionSteeringPhoto from "../assets/parts/suspension-steering.jpg";

const serviceImages: Record<string, ImageMetadata> = {
  "vehicle-removal": vehicleRemovalPhoto,
  "sell-your-car": sellYourCarPhoto,
  "used-parts": usedPartsPhoto,
  "wrecking": wreckingPhoto,
};

const categoryImages: Record<string, ImageMetadata> = {
  "body-panels": bodyPanelsPhoto,
  "cooling": coolingPhoto,
  "electrical": electricalPhoto,
  "engines": enginesPhoto,
  "lights": lightsPhoto,
  "suspension-steering": suspensionSteeringPhoto,
};

const services = await getCollection("services");
const partsCategories = (await getCollection("partsCategories")).slice(0, 6);
---
<BaseLayout
  title="Home"
  description="WRECKON is an Australian auto wrecker and used parts supplier — browse parts by category or vehicle make, or get a quote for your car."
>
  <Hero
    eyebrow="Australian Auto Wreckers"
    title="Quality used parts. A straightforward process."
    subtitle="Tell us about the part you need or the car you want to sell, and we'll get back to you with next steps."
    primaryCta={{ label: "Get Quote", href: "/sell-your-car" }}
    secondaryCta={{ label: "Browse Parts", href: "/parts" }}
  />

  <TrustStrip />

  <Container class="py-20">
    <h2 class="font-display text-3xl font-bold text-ink-900">Our Services</h2>
    <p class="mt-2 max-w-xl text-ink-600">
      From selling your car to sourcing used parts, here's how we can help.
      Descriptions below are preliminary, pending final confirmation from the business.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <Card
          title={service.data.name}
          blurb={service.data.summary}
          href={`/services/${service.id}`}
          image={serviceImages[service.id]}
          imageAlt={serviceImages[service.id] ? `WRECKON ${service.data.name}` : undefined}
        />
      ))}
    </div>
  </Container>

  <div class="bg-ink-100 py-20">
    <Container>
      <h2 class="flex flex-wrap items-center gap-3 font-display text-3xl font-bold text-ink-900">
        Used Parts by Category
        <Placeholder label="SAMPLE CONTENT" />
      </h2>
      <p class="mt-2 max-w-xl text-ink-600">A sample of the part categories we stock. Tell us what you need and we'll check availability.</p>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {partsCategories.map((category) => (
          <Card
            title={category.data.name}
            blurb={category.data.blurb}
            href={`/parts/${category.id}`}
            badge="SAMPLE CONTENT"
            image={categoryImages[category.id]}
            imageAlt={categoryImages[category.id] ? `WRECKON used ${category.data.name}` : undefined}
          />
        ))}
      </div>

      <a href="/parts" class="mt-8 inline-block text-sm font-semibold text-amber-600 hover:text-amber-500">
        View all categories &rarr;
      </a>
    </Container>
  </div>

  <Container class="py-12">
    <p class="text-xs font-bold uppercase tracking-widest text-amber-600">Process</p>
    <h2 class="mt-2 font-display text-2xl font-bold uppercase tracking-tight text-ink-900 md:text-3xl">How It Works</h2>
    <p class="mt-2 max-w-xl text-sm text-ink-600">
      The steps play through automatically — hover or focus any step to hold it.
    </p>

    <div class="mt-5 h-1 w-full overflow-hidden rounded-full bg-ink-100">
      <div id="hiw-progress" class="h-full w-0 bg-amber-400"></div>
    </div>

    <div id="hiw-steps" class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-3">
      {[
        { number: "1", title: "Tell us the details", description: "Submit the form with your vehicle or the part you need." },
        { number: "2", title: "We get back to you", description: "By phone or email, with a quote or availability." },
        { number: "3", title: "We sort the rest", description: "Pick-up and payment, or part delivery — whichever applies." },
      ].map((step, i) => (
        <button
          type="button"
          data-step={i}
          data-active={i === 0 ? "true" : "false"}
          class="group text-left border border-ink-600/15 bg-white p-4 transition-colors duration-300 data-[active=true]:border-amber-400 data-[active=true]:bg-amber-50"
        >
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center bg-amber-400 font-display text-sm font-bold text-ink-950">
              {step.number}
            </span>
            <span class="h-px flex-1 bg-ink-600/15"></span>
          </div>
          <h3 class="mt-3 font-display text-sm font-bold uppercase tracking-wide text-ink-900">{step.title}</h3>
          <p class="mt-1.5 text-xs text-ink-600">{step.description}</p>
        </button>
      ))}
    </div>

    <a href="/how-it-works" class="mt-6 inline-block text-sm font-semibold text-amber-600 hover:text-amber-500">
      See full details &rarr;
    </a>
  </Container>

  <script>
  const steps = Array.from(document.querySelectorAll<HTMLButtonElement>("#hiw-steps [data-step]"));
  const progress = document.getElementById("hiw-progress");
  const DURATION = 4000;
  let active = 0;
  let paused = false;
  let start = performance.now();

  function setActive(index: number) {
    active = index;
    steps.forEach((el, idx) => el.setAttribute("data-active", String(idx === index)));
    start = performance.now();
  }

  steps.forEach((el, idx) => {
    el.addEventListener("mouseenter", () => {
      paused = true;
      setActive(idx);
    });
    el.addEventListener("focus", () => {
      paused = true;
      setActive(idx);
    });
    el.addEventListener("mouseleave", () => {
      paused = false;
      start = performance.now();
    });
    el.addEventListener("blur", () => {
      paused = false;
      start = performance.now();
    });
  });

  function tick(now: number) {
    if (!paused && progress && steps.length > 0) {
      const elapsed = now - start;
      const pct = Math.min(100, (elapsed / DURATION) * 100);
      progress.style.width = `${pct}%`;
      if (elapsed >= DURATION) {
        setActive((active + 1) % steps.length);
      }
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
  </script>
</BaseLayout>
