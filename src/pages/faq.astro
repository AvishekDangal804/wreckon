---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PlaceholderNotice from "../components/PlaceholderNotice.astro";
import { safeJsonLd } from "../lib/safeJsonLd";

const faqs = [
  {
    q: "How do I know if a used part will fit my vehicle?",
    a: "Give us your vehicle's make, model, year and the part you need, and we'll check compatibility before confirming availability.",
  },
  {
    q: "Do you offer any warranty on used parts?",
    a: "Warranty terms will be confirmed here once finalised. Ask us directly when enquiring about a specific part.",
  },
  {
    q: "How does selling my car work?",
    a: "Tell us your vehicle's details through the Sell Your Car page, and we'll get back to you with a quote. Payment is made by bank transfer or EFT.",
  },
  {
    q: "Do you deliver parts, or is pick-up only?",
    a: "Delivery and pick-up options will be confirmed here — contact us directly for your location.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---
<BaseLayout title="FAQ" description="Frequently asked questions about buying parts or selling your car to WRECKON.">
  <script type="application/ld+json" set:html={safeJsonLd(faqSchema)} />
  <Container class="py-16">
    <div class="max-w-2xl">
      <h1 class="font-display text-4xl font-bold text-ink-900">Frequently Asked Questions</h1>

      <div class="mt-6">
        <PlaceholderNotice label="SAMPLE CONTENT">
          A starter set of generic FAQs — to be expanded/corrected with real, business-specific answers.
        </PlaceholderNotice>
      </div>

      <dl class="mt-10 space-y-8">
        {faqs.map((item) => (
          <div>
            <dt class="font-display font-semibold text-ink-900">{item.q}</dt>
            <dd class="mt-2 text-sm text-ink-600">{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Container>
</BaseLayout>
