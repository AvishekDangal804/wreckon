---
import { Image } from "astro:assets";
import logoLight from "../assets/logo-light.png";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<a href="/" class:list={["inline-flex items-center", className]}>
  <Image src={logoLight} alt="WRECKON" class="h-9 w-auto" widths={[220, 440]} sizes="220px" />
</a>
