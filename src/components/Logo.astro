---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<a href="/" class:list={["inline-flex items-center gap-2", className]}>
  <svg viewBox="0 0 48 48" class="h-8 w-8 flex-shrink-0" aria-hidden="true" role="img">
    <rect width="48" height="48" rx="2" fill="#0E2A20" />
    <!-- Subtle kangaroo silhouette watermark behind the W, generic hopping-pose icon (not any specific business's mascot) -->
    <path
      d="M8 38c0-3 1.5-5 3-6.5-1-2-1-4 .5-6 1-1.5 2.5-2 3.5-1.5-1-2 0-4.5 2-6 1.5-1 3-1 4 0 .5-2 2-3.5 3.5-3.5 1 0 2 .5 2.5 1.5.5-1 1.5-1.5 2.5-1.5 2 0 3 2 2.5 4 2 0 3.5 1.5 3.5 3.5 0 1.5-1 3-2.5 3.5 1 1 1.5 2.5 1 4-.5 2-2 3-3.5 3 .5 2.5-.5 5-2.5 6.5-1 .7-2 1-3 1H11c-1.5 0-3-1-3-3z"
      fill="#F4C531"
      opacity="0.14"
    />
    <polyline
      points="10,14 16,34 24,20 32,34 38,14"
      fill="none"
      stroke="#F4C531"
      stroke-width="5"
      stroke-linecap="square"
      stroke-linejoin="miter"
    />
  </svg>
  <span class="font-display text-xl font-bold tracking-tight">WRECKON</span>
</a>
