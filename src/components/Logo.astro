---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<a href="/" class:list={["inline-flex items-center gap-2", className]}>
  <svg viewBox="0 0 48 48" class="h-8 w-8 flex-shrink-0" aria-hidden="true" role="img">
    <rect width="48" height="48" rx="2" fill="#0E2A20" />
    <polyline
      points="10,14 16,34 24,20 32,34 38,14"
      fill="none"
      stroke="#F4C531"
      stroke-width="5"
      stroke-linecap="square"
      stroke-linejoin="miter"
    />
  </svg>
  <span class="font-display text-xl font-bold tracking-tight">WRECKON</span>
</a>
