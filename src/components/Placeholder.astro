---
interface Props {
  label: "SAMPLE CONTENT" | "TO BE CONFIRMED" | "PENDING CLIENT CONFIRMATION" | "CLIENT CONTENT REQUIRED";
}
const { label } = Astro.props;
---
<span class="inline-flex items-center whitespace-nowrap rounded-sm bg-amber-200 px-1 py-0.5 align-middle text-[8px] font-semibold uppercase tracking-normal text-ink-900">
  {label}
</span>
