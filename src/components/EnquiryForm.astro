---
interface Props {
  subject?: string;
  showVehicleFields?: boolean;
  submitLabel?: string;
}
const {
  subject = "General Enquiry",
  showVehicleFields = true,
  submitLabel = "Send Enquiry",
} = Astro.props;
const formId = `enquiry-${subject.toLowerCase().replace(/\s+/g, "-")}`;
---
<form
  id={formId}
  class="enquiry-form grid grid-cols-1 gap-4 md:grid-cols-2"
  method="POST"
  action="/api/enquiry"
>
  <input type="hidden" name="subject" value={subject} />

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Name
    <input required name="name" type="text" class="rounded-md border border-ink-600/30 bg-white px-3 py-2 text-sm" />
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Phone
    <input required name="phone" type="tel" class="rounded-md border border-ink-600/30 bg-white px-3 py-2 text-sm" />
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800 md:col-span-2">
    Email
    <input required name="email" type="email" class="rounded-md border border-ink-600/30 bg-white px-3 py-2 text-sm" />
  </label>

  {showVehicleFields && (
    <>
      <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
        Vehicle Make
        <input name="vehicleMake" type="text" class="rounded-md border border-ink-600/30 bg-white px-3 py-2 text-sm" />
      </label>
      <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
        Model &amp; Year
        <input name="vehicleModelYear" type="text" class="rounded-md border border-ink-600/30 bg-white px-3 py-2 text-sm" />
      </label>
    </>
  )}

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800 md:col-span-2">
    Message
    <textarea name="message" rows="4" class="rounded-md border border-ink-600/30 bg-white px-3 py-2 text-sm"></textarea>
  </label>

  <div class="md:col-span-2">
    <button
      type="submit"
      class="inline-flex items-center justify-center rounded-full bg-amber-400 px-6 py-3 text-sm font-semibold text-ink-950 hover:bg-amber-300 transition-colors"
    >
      {submitLabel}
    </button>
    <p class="form-status mt-3 text-sm" role="status"></p>
  </div>
</form>

<script>
  document.querySelectorAll(".enquiry-form").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formEl = form as HTMLFormElement;
      const status = formEl.querySelector(".form-status") as HTMLElement | null;
      const submitBtn = formEl.querySelector('button[type="submit"]') as HTMLButtonElement | null;

      if (submitBtn) submitBtn.disabled = true;
      if (status) {
        status.textContent = "Sending…";
        status.className = "form-status mt-3 text-sm text-ink-600";
      }

      try {
        const res = await fetch("/api/enquiry", {
          method: "POST",
          body: new FormData(formEl),
        });
        const data = await res.json();

        if (res.ok) {
          if (status) {
            status.textContent = data.message ?? "Thanks — we've received your enquiry.";
            status.className = "form-status mt-3 text-sm text-green-700";
          }
          formEl.reset();
        } else {
          if (status) {
            status.textContent = data.message ?? "Something went wrong. Please call us instead.";
            status.className = "form-status mt-3 text-sm text-red-700";
          }
        }
      } catch {
        if (status) {
          status.textContent = "Something went wrong. Please call us instead.";
          status.className = "form-status mt-3 text-sm text-red-700";
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  });
</script>
