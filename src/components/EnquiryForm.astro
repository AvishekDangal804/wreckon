---
import Button from "./Button.astro";

interface Props {
  subject?: string;
  showVehicleFields?: boolean;
  submitLabel?: string;
}
const {
  subject = "General Enquiry",
  showVehicleFields = true,
  submitLabel = "Send Enquiry",
} = Astro.props;
const formId = `enquiry-${subject.toLowerCase().replace(/\s+/g, "-")}`;
---
<form
  id={formId}
  class="enquiry-form grid grid-cols-1 gap-4 md:grid-cols-2"
  method="POST"
  action="/api/enquiry"
>
  <input type="hidden" name="subject" value={subject} />
  <input type="hidden" name="type" value="general_contact" />
  <input
    type="text"
    name="company"
    tabindex="-1"
    autocomplete="off"
    class="absolute left-[-9999px]"
    aria-hidden="true"
  />

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Name
    <input required name="name" type="text" class="field-input" />
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Phone
    <input required name="phone" type="tel" class="field-input" />
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800 md:col-span-2">
    Email
    <input required name="email" type="email" class="field-input" />
  </label>

  {showVehicleFields && (
    <>
      <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
        Vehicle Make
        <input name="vehicleMake" type="text" class="field-input" />
      </label>
      <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
        Model &amp; Year
        <input name="vehicleModelYear" type="text" class="field-input" />
      </label>
    </>
  )}

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800 md:col-span-2">
    Message
    <textarea name="message" rows="4" class="field-input"></textarea>
  </label>

  <div class="md:col-span-2">
    {Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY) && (
      <div class="cf-turnstile mb-4" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>
    )}
    <Button type="submit">{submitLabel}</Button>
    <p class="form-status mt-3 text-sm" role="status"></p>
  </div>
</form>

<script>
  import { initEnquiryForms } from "../lib/enquiryFormClient";
  initEnquiryForms();
</script>
