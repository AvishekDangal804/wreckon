---
interface Props {
  href?: string;
  type?: "button" | "submit";
  variant?: "primary" | "secondary";
  size?: "md" | "sm";
  /** Only for non-conflicting additions (e.g. margin) — never padding/color/radius, which Tailwind's cascade order can't reliably override here. */
  class?: string;
}
const { href, type = "button", variant = "primary", size = "md", class: extra = "" } = Astro.props;

const base = "inline-flex items-center justify-center rounded-sm text-sm font-semibold transition-colors";
const sizes = {
  md: "px-6 py-3",
  sm: "px-4 py-2",
};
const variants = {
  primary: "bg-amber-400 text-ink-950 hover:bg-amber-500",
  secondary: "border border-ink-600 text-ink-50 hover:border-amber-400 hover:text-amber-400",
};
const classes = [base, sizes[size], variants[variant], extra].join(" ");
---
{href ? (
  <a href={href} class={classes}><slot /></a>
) : (
  <button type={type} class={classes}><slot /></button>
)}
