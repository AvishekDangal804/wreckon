---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Placeholder from "./Placeholder.astro";

interface Props {
  title: string;
  blurb: string;
  href: string;
  badge?: "CLIENT CONTENT REQUIRED";
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, blurb, href, badge, image, imageAlt = "" } = Astro.props;
---
<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-sm border border-ink-200 bg-white transition-colors hover:border-ink-800"
>
  {image && (
    <Image src={image} alt={imageAlt} class="h-40 w-full object-cover" widths={[400, 800]} sizes="(min-width: 1024px) 400px, 100vw" />
  )}
  <div class="flex flex-col p-6">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display text-lg font-semibold text-ink-900 group-hover:text-amber-500">
        {title}
      </h3>
      {badge && <Placeholder label={badge} />}
    </div>
    <p class="mt-2 text-sm text-ink-600">{blurb}</p>
    <span class="mt-4 text-sm font-semibold text-amber-500">Learn more &rarr;</span>
  </div>
</a>
