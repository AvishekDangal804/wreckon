---
interface Props {
  title: string;
  blurb: string;
  href: string;
}
const { title, blurb, href } = Astro.props;
---
<a
  href={href}
  class="group flex flex-col rounded-sm border border-ink-200 bg-white p-6 transition-colors hover:border-ink-800"
>
  <h3 class="font-display text-lg font-semibold text-ink-900 group-hover:text-amber-500">
    {title}
  </h3>
  <p class="mt-2 text-sm text-ink-600">{blurb}</p>
  <span class="mt-4 text-sm font-semibold text-amber-500">Learn more &rarr;</span>
</a>
