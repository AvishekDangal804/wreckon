---
import { Image } from "astro:assets";
import Logo from "./Logo.astro";
import { siteConfig } from "../lib/siteConfig";
import footerAccent from "../assets/footer-accent.jpg";

const currentYear = new Date().getFullYear();
---
<footer class="bg-ink-950 text-ink-200">
  <div class="grid grid-cols-1 lg:grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))]">
    <div class="order-1 flex flex-col justify-between gap-8 py-14 pl-[max(1.5rem,calc((100vw-72rem)/2))] pr-6 md:pr-16">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
        <div>
          <Logo />
          <p class="mt-3 text-sm text-ink-400">{siteConfig.tagline}</p>
        </div>

        <div>
          <p class="font-display text-lg font-bold text-ink-50">Quick Links</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/services" class="hover:text-amber-400">Services</a></li>
            <li><a href="/parts" class="hover:text-amber-400">Used Parts</a></li>
            <li><a href="/makes" class="hover:text-amber-400">Browse by Make</a></li>
            <li><a href="/sell-your-car" class="hover:text-amber-400">Sell Your Car</a></li>
            <li><a href="/contact" class="hover:text-amber-400">About & Contact</a></li>
          </ul>
        </div>

        <div>
          <p class="font-display text-lg font-bold text-ink-50">Opening Hours</p>
          <ul class="mt-3 space-y-2 text-sm">
            {siteConfig.hours.map((h) => (
              <li>{h.days}: {h.time}</li>
            ))}
          </ul>
        </div>

        <div>
          <p class="font-display text-lg font-bold text-ink-50">Contact</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <span class="font-mono font-semibold text-amber-400">{siteConfig.phone.display}</span>
            </li>
            <li class="flex items-center gap-2">
              <span>{siteConfig.email}</span>
            </li>
            <li class="flex items-center gap-2 text-ink-400">
              <span>{siteConfig.address.street}, {siteConfig.address.suburb} {siteConfig.address.state} {siteConfig.address.postcode}</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="flex flex-col gap-2 border-t border-ink-800 pt-6 text-xs text-ink-400 sm:flex-row sm:items-center sm:justify-between">
        <span>
          &copy; {currentYear} {siteConfig.name}. All rights reserved. ·
          <a href="/privacy" class="hover:text-amber-400">Privacy</a> ·
          <a href="/terms" class="hover:text-amber-400">Terms</a> ·
          <a href="/faq" class="hover:text-amber-400">FAQ</a>
        </span>
        <span>Site content is a preview build pending final business details.</span>
      </div>
    </div>

    <div class="relative order-2 hidden min-h-[320px] lg:block" aria-hidden="true">
      <Image
        src={footerAccent}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
        widths={[640, 1024]}
        sizes="50vw"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/60 to-ink-950/10"></div>
    </div>
  </div>
</footer>
