---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "./Button.astro";
import heroYard from "../assets/hero-yard.jpg";

interface Cta {
  label: string;
  href: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
  image?: ImageMetadata;
  imageAlt?: string;
}
const {
  eyebrow,
  title,
  subtitle,
  primaryCta,
  secondaryCta,
  image = heroYard,
  imageAlt = "WRECKON vehicle wrecking yard",
} = Astro.props;
---
<section class="relative overflow-hidden bg-ink-950 text-ink-50">
  <Image
    src={image}
    alt={imageAlt}
    class="absolute inset-0 h-full w-full object-cover"
    widths={[640, 1024, 1600, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink-950/70 via-ink-950/35 to-ink-950/5"></div>

  <div class="relative mx-auto max-w-6xl px-6 py-24 md:py-32">
    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-widest text-amber-400 drop-shadow-[0_1px_6px_rgba(0,0,0,0.6)]">{eyebrow}</p>
    )}
    <h1 class="mt-4 max-w-2xl font-display text-4xl font-bold leading-tight md:text-6xl drop-shadow-[0_2px_10px_rgba(0,0,0,0.6)]">
      {title}
    </h1>
    <p class="mt-6 max-w-xl text-lg text-ink-200 drop-shadow-[0_1px_6px_rgba(0,0,0,0.6)]">
      {subtitle}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <Button href={primaryCta.href}>{primaryCta.label}</Button>
      {secondaryCta && (
        <Button href={secondaryCta.href} variant="secondary">{secondaryCta.label}</Button>
      )}
    </div>
  </div>
</section>
