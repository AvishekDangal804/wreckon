---
import Button from "./Button.astro";

interface Props {
  submitLabel?: string;
  defaultVehicleMake?: string;
  dark?: boolean;
}
const { submitLabel = "Get a Quote", defaultVehicleMake = "", dark = false } = Astro.props;

const inputClass = dark ? "field-input-dark" : "field-input";
const labelClass = `flex flex-col gap-1 text-sm font-medium ${dark ? "text-ink-100" : "text-ink-800"}`;
const labelClassWide = `${labelClass} md:col-span-2`;
const hintClass = dark ? "text-xs text-ink-200" : "text-xs text-ink-500";
---
<form class="enquiry-form grid grid-cols-1 gap-4 md:grid-cols-2" method="POST" action="/api/enquiry" data-dark={dark ? "true" : undefined}>
  <input type="hidden" name="type" value="vehicle_valuation" />
  <input
    type="text"
    name="company"
    tabindex="-1"
    autocomplete="off"
    class="absolute left-[-9999px]"
    aria-hidden="true"
  />

  <label class={labelClass}>
    Full Name *
    <input required name="name" type="text" class={inputClass} />
  </label>
  <label class={labelClass}>
    Contact Number *
    <input required name="phone" type="tel" class={inputClass} />
  </label>
  <label class={labelClassWide}>
    Email Address *
    <input required name="email" type="email" class={inputClass} />
  </label>

  <label class={labelClass}>
    Vehicle Make *
    <input required name="vehicleMake" type="text" value={defaultVehicleMake} class={inputClass} />
  </label>
  <label class={labelClass}>
    Vehicle Model *
    <input required name="vehicleModel" type="text" class={inputClass} />
  </label>
  <label class={labelClass}>
    Year *
    <input required name="vehicleYear" type="text" class={inputClass} />
  </label>
  <label class={labelClass}>
    Vehicle Location *
    <input required name="location" type="text" placeholder="Suburb" class={inputClass} />
  </label>

  <label class={labelClass}>
    Condition *
    <select required name="condition" class={inputClass}>
      <option value="">Select condition</option>
      <option value="Excellent">Excellent</option>
      <option value="Good">Good</option>
      <option value="Fair">Fair</option>
      <option value="Poor">Poor</option>
      <option value="Accident">Accident</option>
    </select>
  </label>
  <label class={labelClass}>
    Is It Drivable? *
    <select required name="drivable" class={inputClass}>
      <option value="">Select one</option>
      <option value="Yes">Yes</option>
      <option value="No">No</option>
    </select>
  </label>
  <label class={labelClassWide}>
    Transmission
    <select name="transmission" class={inputClass}>
      <option value="">Not sure / not applicable</option>
      <option value="Automatic">Automatic</option>
      <option value="Manual">Manual</option>
    </select>
  </label>

  <label class={labelClassWide}>
    Additional Information
    <textarea name="additionalInfo" rows="3" class={inputClass}></textarea>
  </label>

  <label class={labelClassWide}>
    Vehicle Photos (optional)
    <input
      name="photos"
      type="file"
      accept="image/*"
      multiple
      class={inputClass}
    />
    <span class={hintClass}>Images only, up to 8MB each.</span>
  </label>

  <div class="md:col-span-2">
    {Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY) && (
      <div class="cf-turnstile mb-4" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>
    )}
    <Button type="submit">{submitLabel}</Button>
    <p class="form-status mt-3 text-sm" role="status"></p>
  </div>
</form>

<script>
  import { initEnquiryForms } from "../lib/enquiryFormClient";
  initEnquiryForms();
</script>
