---
import Button from "./Button.astro";

interface Props {
  submitLabel?: string;
  defaultVehicleMake?: string;
}
const { submitLabel = "Get a Quote", defaultVehicleMake = "" } = Astro.props;
---
<form class="enquiry-form grid grid-cols-1 gap-4 md:grid-cols-2" method="POST" action="/api/enquiry">
  <input type="hidden" name="type" value="vehicle_valuation" />
  <input
    type="text"
    name="company"
    tabindex="-1"
    autocomplete="off"
    class="absolute left-[-9999px]"
    aria-hidden="true"
  />

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Full Name *
    <input required name="name" type="text" class="field-input" />
  </label>
  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Contact Number *
    <input required name="phone" type="tel" class="field-input" />
  </label>
  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800 md:col-span-2">
    Email Address *
    <input required name="email" type="email" class="field-input" />
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Vehicle Make *
    <input required name="vehicleMake" type="text" value={defaultVehicleMake} class="field-input" />
  </label>
  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Vehicle Model *
    <input required name="vehicleModel" type="text" class="field-input" />
  </label>
  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Year *
    <input required name="vehicleYear" type="text" class="field-input" />
  </label>
  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Vehicle Location *
    <input required name="location" type="text" placeholder="Suburb" class="field-input" />
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Condition *
    <select required name="condition" class="field-input">
      <option value="">Select condition</option>
      <option value="Excellent">Excellent</option>
      <option value="Good">Good</option>
      <option value="Fair">Fair</option>
      <option value="Poor">Poor</option>
      <option value="Accident">Accident</option>
    </select>
  </label>
  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800">
    Is It Drivable? *
    <select required name="drivable" class="field-input">
      <option value="">Select one</option>
      <option value="Yes">Yes</option>
      <option value="No">No</option>
    </select>
  </label>
  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800 md:col-span-2">
    Transmission
    <select name="transmission" class="field-input">
      <option value="">Not sure / not applicable</option>
      <option value="Automatic">Automatic</option>
      <option value="Manual">Manual</option>
    </select>
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800 md:col-span-2">
    Additional Information
    <textarea name="additionalInfo" rows="3" class="field-input"></textarea>
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink-800 md:col-span-2">
    Vehicle Photos (optional)
    <input
      name="photos"
      type="file"
      accept="image/*"
      multiple
      class="field-input"
    />
    <span class="text-xs text-ink-500">Images only, up to 8MB each.</span>
  </label>

  <div class="md:col-span-2">
    {Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY) && (
      <div class="cf-turnstile mb-4" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>
    )}
    <Button type="submit">{submitLabel}</Button>
    <p class="form-status mt-3 text-sm" role="status"></p>
  </div>
</form>

<script>
  import { initEnquiryForms } from "../lib/enquiryFormClient";
  initEnquiryForms();
</script>
