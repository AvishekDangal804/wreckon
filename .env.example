# Copy to .env and fill in to enable real enquiry-form email delivery.
# Without these, /api/enquiry still accepts submissions and logs them
# server-side, but does not send anywhere — see README.

RESEND_API_KEY=
ENQUIRY_TO_EMAIL=

# Postgres connection string (e.g. from Neon, including Vercel's native Neon
# integration). Without this, enquiries are still emailed/logged as above but
# nothing is persisted, and /admin shows "database not configured".
DATABASE_URL=

# Vercel Blob read/write token, for photo uploads on the parts-request and
# sell-your-car forms. Without this, forms still submit but any attached
# photos are skipped — not uploaded, not linked in the email/DB record.
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile keys (free — https://dash.cloudflare.com/?to=/:account/turnstile).
# PUBLIC_TURNSTILE_SITE_KEY is exposed to the browser to render the widget.
# Without both set, the Turnstile widget is hidden and server-side verification
# is skipped entirely (no spam gate from this layer).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (free tier — https://console.upstash.com) for enquiry-form rate
# limiting. Without these, rate limiting is skipped (submissions are never
# blocked for rate, only by Turnstile/honeypot if those are configured).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin login for /admin (view submitted enquiries). Without both set, /admin
# shows a "not configured" message instead of a login form.
ADMIN_PASSWORD=
SESSION_SECRET=
